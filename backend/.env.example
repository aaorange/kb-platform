# ===== 环境配置模板 =====
# 使用方法：复制本文件为 backend/.env.production（Docker 部署）或 backend/.env（本地开发），
# 并将所有 CHANGE_ME 项替换为真实值。切勿将填好的文件提交到 Git。

APP_NAME=KB Platform
DEBUG=false
ACCESS_TOKEN_EXPIRE_HOURS=24

# 前端访问入口（同源反代，按服务器实际 IP/域名填写，多个用逗号分隔，不要用通配符 *）
CORS_ORIGINS=http://CHANGE_ME_SERVER_IP

# 会话签名密钥：在服务器上执行 openssl rand -hex 32 生成
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# 容器内路径（SQLite 挂载在 data/ 卷）
DATABASE_URL=sqlite+aiosqlite:////app/data/kb.db

# Redis 容器（FAQ 缓存）
REDIS_URL=redis://redis:6379/0

# ===== Milvus（compose 内置 standalone，容器互联）=====
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=knowledge_chunks_v2
MILVUS_ITEM_COLLECTION=kb_item_names

# ===== GPU 编码服务（bge-m3，需先部署 gpu-services 到 GPU 服务器）=====
# 地址漂移后需同步更新并重启 backend 容器
EMBEDDING_API_URL=http://CHANGE_ME_GPU_HOST:6006/v1/embeddings
EMBEDDING_API_KEY=CHANGE_ME_GPU_BEARER_TOKEN
BGE_DEVICE=cuda:0
BGE_FP16=true

# ===== Rerank 服务（bge-reranker-large，与编码服务同机部署）=====
RERANK_MODE=gpu
RERANKER_API_URL=http://CHANGE_ME_GPU_HOST:6006/v1/rerank
RERANKER_API_KEY=CHANGE_ME_GPU_BEARER_TOKEN

# ===== LLM（引擎查询图：实体提取/HyDE/答案生成/主体识别）=====
# 示例为 DeepSeek，也可换用任意 OpenAI 兼容接口（如 DashScope qwen-plus）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
ITEM_MODEL=deepseek-chat
# VL 模型（图片摘要，仅带图 PDF 解析时用到；走 DashScope 的 OpenAI 兼容接口）
VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen3-vl-flash
VL_API_KEY=CHANGE_ME_VL_API_KEY
LLM_TEMPERATURE=0.1

# ===== MinIO（知识图片托管；ENDPOINT 为容器内操作地址，PUBLIC_URL 为浏览器读图前缀）=====
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://CHANGE_ME_SERVER_IP/kb-img
MINIO_ACCESS_KEY=kb_minio_admin
# 必须与 docker-compose.yml 中 MINIO_ROOT_PASSWORD（或根目录 .env 的同名变量）一致
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=upload-images

# ===== PDF 解析（可选：MinerU；不配 TOKEN 则纯文本 PDF 走 pypdf 本地降级）=====
# MINERU_API_TOKEN=
# MINERU_BASE_URL=https://mineru.net/api/v4

# ===== 联网搜索（企业知识库默认关闭）=====
WEB_MCP_ENABLE=0

# 上传文件持久化到 data 卷
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=40
